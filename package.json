{
  "name": "slack2md",
  "version": "1.0.0",
  "description": "Export Slack conversations to Markdown for NotebookLM",
  "type": "module",
  "scripts": {
    "load:metadata": "tsx src/commands/load-metadata.ts",
    "load:messages": "tsx src/commands/load-messages.ts",
    "generate": "tsx src/commands/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "slack",
    "markdown",
    "notebooklm"
  ],
  "author": "Yuya Takeyama",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@slack/web-api": "^7.13.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
